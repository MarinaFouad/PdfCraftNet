@page
@model PdfCraftNet.Pages.CbzToPdfModel
@{
    ViewData["Title"] = "CBZ to PDF";
}

<div class="card">
    <h1>📚 CBZ to PDF</h1>
    <p class="subtitle">Convert a comic book archive (.cbz — a zip of images) into a PDF.</p>

    <form method="post" enctype="multipart/form-data">
        <label for="file">CBZ file</label>
        <input type="file" id="file" name="File" accept=".cbz,.zip" required />

        <button type="submit">Convert to PDF</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }
</div>
