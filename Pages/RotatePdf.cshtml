@page
@model PdfCraftNet.Pages.RotatePdfModel
@{
    ViewData["Title"] = "Rotate PDF";
}

<div class="card">
    <h1>🔄 Rotate PDF</h1>
    <p class="subtitle">Rotate all pages, or just specific ones, by a fixed angle.</p>

    <form method="post" enctype="multipart/form-data">
        <label for="file">PDF file</label>
        <input type="file" id="file" name="File" accept="application/pdf" required />

        <label for="degrees">Rotation</label>
        <select id="degrees" name="Degrees">
            <option value="90">90° clockwise</option>
            <option value="180">180°</option>
            <option value="270">270° clockwise (90° counter-clockwise)</option>
        </select>

        <label for="pages">Pages (optional)</label>
        <input type="text" id="pages" name="PageSpec" placeholder="Leave blank for all pages, or e.g. 1,3-4" />

        <button type="submit">Rotate PDF</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }
</div>
