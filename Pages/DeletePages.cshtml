@page
@model PdfCraftNet.Pages.DeletePagesModel
@{
    ViewData["Title"] = "Delete Pages";
}

<div class="card">
    <h1>🗑️ Delete Pages</h1>
    <p class="subtitle">Remove specific pages from a PDF.</p>

    <form method="post" enctype="multipart/form-data">
        <label for="file">PDF file</label>
        <input type="file" id="file" name="File" accept="application/pdf" required />

        <label for="pages">Pages to delete</label>
        <input type="text" id="pages" name="PageSpec" placeholder="e.g. 2,4-6" required />
        <p class="hint">Comma-separated page numbers and/or ranges, 1-based.</p>

        <button type="submit">Delete Pages</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }
</div>
