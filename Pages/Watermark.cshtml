@page
@model PdfCraftNet.Pages.WatermarkModel
@{
    ViewData["Title"] = "Add Watermark";
}

<div class="card">
    <h1>💧 Add Watermark</h1>
    <p class="subtitle">Stamp a diagonal text watermark across every page.</p>

    <form method="post" enctype="multipart/form-data">
        <label for="file">PDF file</label>
        <input type="file" id="file" name="File" accept="application/pdf" required />

        <label for="text">Watermark text</label>
        <input type="text" id="text" name="Text" placeholder="e.g. CONFIDENTIAL" required />

        <label for="fontSize">Font size</label>
        <input type="number" id="fontSize" name="FontSize" min="8" max="200" value="48" />

        <label for="opacity">Opacity (0.0 – 1.0)</label>
        <input type="number" id="opacity" name="Opacity" min="0.05" max="1" step="0.05" value="0.3" />

        <button type="submit">Add Watermark</button>
    </form>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="error">@Model.ErrorMessage</div>
    }
</div>
