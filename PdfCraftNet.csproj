<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>PdfCraftNet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- MIT-licensed PDF manipulation library (.NET Core port of PDFsharp) -->
    <PackageReference Include="PdfSharpCore" Version="1.3.65" />

    <!-- Image decode/encode across jpg/png/bmp/tiff/webp/gif.
         Pinned to the 2.x line intentionally: PdfSharpCore's compiled DLL calls an
         Image.Load(Stream, out IImageFormat) overload that was removed in ImageSharp 3.x.
         Bumping this to 3.x causes a runtime MissingMethodException. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.9" />

    <!-- SVG rasterization -->
    <PackageReference Include="Svg.Skia" Version="2.0.0.2" />

    <!-- Renders PDF pages into bitmaps (wraps PDFium natively, MIT licensed) -->
    <PackageReference Include="PDFtoImage" Version="5.3.0" />
  </ItemGroup>

</Project>
